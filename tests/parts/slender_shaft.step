#519 = ( CONVERSION_BASED_UNIT('INCH',#521) LENGTH_UNIT() NAMED_UNIT(
  #520) );
#520 = DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#521 = LENGTH_MEASURE_WITH_UNIT(25.4,#522);
#522 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#523 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#524 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#525 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(3.937007874016E-09),
  #519,'distance_accuracy_value','confusion accuracy');
#526 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
